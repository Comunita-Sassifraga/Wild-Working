# Copy to .env.local (gitignored) and fill from `supabase status -o env`.
# Never commit real keys. The test suite reads `supabase status` directly
# and does not need this file.
#
# No variable carries the NEXT_PUBLIC_ prefix on purpose: the app talks to
# Supabase from the server only, and nothing here reaches the browser.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret behind the fingerprints of the sign-in request limit (SPEC §6.1).
# Any long random string; changing it resets the hourly counters. Never
# reuse a Supabase key here.
CHIAVE_IMPRONTE_ACCESSO=

# Recipient of public-name moderation notices (SPEC §10). A board mailbox.
EMAIL_MODERAZIONE=

# --- Posta e mestieri automatici (SPEC §12 passo 9) ---------------------------
# In sviluppo lasciali vuoti: le email dell'app finiscono in Mailpit, insieme
# ai link di accesso (http://127.0.0.1:54324).

# Chiave di Resend. Solo in produzione: senza, si scrive a Mailpit.
RESEND_API_KEY=

# Forza la consegna locale anche quando esiste una chiave di Resend. È quello
# che impedisce a una prova di raggiungere una casella vera.
# POSTA_LOCALE=http://127.0.0.1:54324

# Segreto con cui il programmatore di orari chiama /api/mestieri/*. Il nome è
# quello che Vercel si aspetta: se la variabile esiste, la manda come bearer
# token a ogni chiamata programmata. Una stringa lunga e casuale.
CRON_SECRET=

# Indirizzo pubblico dell'app, usato nei collegamenti dentro le email.
# In sviluppo: http://127.0.0.1:3000
URL_APP=

# Indirizzo mostrato a chi non riesce a usare il cartoncino di «Prenota un
# abitante» (SPEC §15.13). Una casella del Direttivo. Finché è vuota, la
# pagina mostra l'indirizzo dell'associazione che è già nel piè di pagina.
EMAIL_ASSISTENZA_ABITANTI=
